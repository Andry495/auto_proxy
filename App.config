<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    
    <appSettings>
        <add key="ProxyStoragePath" value="proxies.txt" />
        <add key="CheckIntervalMinutes" value="5" />
        <add key="MaxConcurrentChecks" value="10" />
        <add key="TimeoutSeconds" value="10" />
        <add key="AutoRefreshEnabled" value="false" />
        <add key="BackgroundModeEnabled" value="false" />
    </appSettings>
    
    <system.net>
        <settings>
            <httpWebRequest useUnsafeHeaderParsing="true" />
        </settings>
    </system.net>
</configuration>
